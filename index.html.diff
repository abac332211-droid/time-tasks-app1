 /* ============ Backup & Restore ============ */
 
+/*
+ * The exported focus timer is always a safe, paused snapshot. A backup must
+ * never resume elapsed time automatically on another device. If a Pomodoro
+ * phase already ended, preserve the pending confirmation instead of silently
+ * losing the completed phase or logging it twice.
+ */
+function _buildFocusTimerBackupSnapshot(timer, now, elapsedSec, phaseTargetSec, taskIds) {
+  if (!timer || typeof timer !== "object" || Array.isArray(timer)) return null;
+
+  var snapshot = {
+    mode: timer.mode,
+    phase: timer.phase,
+    running: timer.running === true,
+    baseElapsed: timer.baseElapsed,
+    startedAt: timer.startedAt,
+    cyclePosition: timer.cyclePosition,
+    taskId: timer.taskId,
+    sessionStartAt: timer.sessionStartAt,
+    awaitingConfirmation: timer.awaitingConfirmation === true,
+    pendingPhaseEndedAt: timer.pendingPhaseEndedAt
+  };
+  var capturedAt = Number.isFinite(now) ? now : Date.now();
+
+  if (snapshot.running) {
+    var elapsed = Number.isFinite(elapsedSec)
+      ? Math.max(0, Math.floor(elapsedSec))
+      : Math.max(0, Math.floor(Number(snapshot.baseElapsed) || 0));
+
+    if (snapshot.mode === "pomodoro" && Number.isFinite(phaseTargetSec)
+        && elapsed >= phaseTargetSec && !snapshot.awaitingConfirmation) {
+      var segmentStart = Number.isFinite(snapshot.startedAt) ? snapshot.startedAt : capturedAt;
+      var previousElapsed = Number.isFinite(snapshot.baseElapsed) ? snapshot.baseElapsed : 0;
+      snapshot.pendingPhaseEndedAt = segmentStart
+        + Math.max(0, phaseTargetSec - previousElapsed) * 1000;
+      snapshot.baseElapsed = phaseTargetSec;
+      snapshot.awaitingConfirmation = true;
+    } else {
+      snapshot.baseElapsed = elapsed;
+      if (!snapshot.awaitingConfirmation) snapshot.pendingPhaseEndedAt = null;
+    }
+    snapshot.running = false;
+  }
+
+  // startedAt is meaningful only while running; snapshots are deliberately paused.
+  snapshot.startedAt = null;
+  if (snapshot.taskId !== null && snapshot.taskId !== undefined
+      && (!Number.isInteger(snapshot.taskId) || !taskIds || !taskIds.has(snapshot.taskId))) {
+    snapshot.taskId = null;
+  }
+  if (snapshot.taskId === undefined) snapshot.taskId = null;
+  if (snapshot.sessionStartAt === undefined) snapshot.sessionStartAt = null;
+  if (snapshot.pendingPhaseEndedAt === undefined) snapshot.pendingPhaseEndedAt = null;
+  return snapshot;
+}
